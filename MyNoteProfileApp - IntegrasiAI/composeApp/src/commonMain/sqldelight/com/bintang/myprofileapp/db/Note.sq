-- =============================================================
-- Note.sq — SQLDelight schema untuk tabel Note
-- Semua CRUD queries dan search didefinisikan di sini.
-- SQLDelight akan men-generate Kotlin code secara otomatis.
-- =============================================================

-- Definisi tabel Note
CREATE TABLE Note (
  id          INTEGER PRIMARY KEY AUTOINCREMENT,
  title       TEXT    NOT NULL,
  content     TEXT    NOT NULL,
  is_favorite INTEGER NOT NULL DEFAULT 0,
  created_at  INTEGER NOT NULL,
  updated_at  INTEGER NOT NULL
);

-- Index untuk kolom yang sering di-query (optimasi sorting)
CREATE INDEX idx_note_updated_at ON Note(updated_at);
CREATE INDEX idx_note_created_at ON Note(created_at);

-- ─── READ QUERIES ───────────────────────────────────────────

-- Ambil semua notes, urutkan berdasarkan updated_at terbaru
selectAll:
SELECT * FROM Note ORDER BY updated_at DESC;

-- Ambil semua notes, urutkan berdasarkan created_at ascending
selectAllByCreatedAsc:
SELECT * FROM Note ORDER BY created_at ASC;

-- Ambil semua notes, urutkan berdasarkan created_at descending
selectAllByCreatedDesc:
SELECT * FROM Note ORDER BY created_at DESC;

-- Ambil semua notes, urutkan berdasarkan title ascending (A-Z)
selectAllByTitleAsc:
SELECT * FROM Note ORDER BY title ASC;

-- Ambil semua notes, urutkan berdasarkan title descending (Z-A)
selectAllByTitleDesc:
SELECT * FROM Note ORDER BY title DESC;

-- Ambil satu note berdasarkan ID
selectById:
SELECT * FROM Note WHERE id = ?;

-- ─── CREATE ─────────────────────────────────────────────────

-- Insert note baru
insert:
INSERT INTO Note(title, content, is_favorite, created_at, updated_at)
VALUES (?, ?, ?, ?, ?);

-- ─── UPDATE ─────────────────────────────────────────────────

-- Update title dan content note
update:
UPDATE Note SET title = ?, content = ?, updated_at = ? WHERE id = ?;

-- Toggle status favorite (0 → 1, 1 → 0)
toggleFavorite:
UPDATE Note SET is_favorite = CASE WHEN is_favorite = 0 THEN 1 ELSE 0 END, updated_at = ? WHERE id = ?;

-- ─── DELETE ─────────────────────────────────────────────────

-- Hapus note berdasarkan ID
delete:
DELETE FROM Note WHERE id = ?;

-- ─── SEARCH ─────────────────────────────────────────────────

-- Cari notes berdasarkan title atau content (SQL LIKE pattern)
search:
SELECT * FROM Note WHERE title LIKE ? OR content LIKE ? ORDER BY updated_at DESC;
